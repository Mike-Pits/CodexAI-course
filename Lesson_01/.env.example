# Скопируйте в .env. Никогда не отправляйте файл с ключом в архив или Git.
# mock — без внешних запросов; llm — выбранный провайдер.
CHAT_MODE=mock
# Базовый URL без /chat/completions или /responses.
LLM_BASE_URL=https://api.vsellm.ru/v1
LLM_API_KEY=
# Точный ID из каталога провайдера.
LLM_MODEL=
# chat_completions — VseLLM; responses — OpenAI Responses.
LLM_API_FORMAT=chat_completions
LLM_TOKEN_PARAMETER=max_tokens
# Необязательный параметр, зависит от модели/провайдера.
LLM_REASONING_EFFORT=
# Включает внутренние reasoning-токены; для medium начните с 2000.
MAX_OUTPUT_TOKENS=600
# Сгенерировать: python3 -c 'import secrets; print(secrets.token_hex(32))'
QUOTA_SECRET=
REQUESTS_PER_MINUTE=5
REQUESTS_PER_DAY=100
PUBLIC_ORIGIN=http://127.0.0.1:8000
# Для VPS: домен без https:// и порта, PUBLIC_ORIGIN=https://тот-же-домен:8443
DOMAIN=
ACME_EMAIL=
