{
    email {$ACME_EMAIL}
    admin off
}
{$DOMAIN}:8443 {
    tls {
        issuer acme {
            disable_tlsalpn_challenge
        }
    }
    request_body {
        max_size 64KB
    }
    header Strict-Transport-Security "max-age=31536000"
    reverse_proxy app:8000 {
        header_up X-Real-IP {http.request.remote.host}
    }
}
