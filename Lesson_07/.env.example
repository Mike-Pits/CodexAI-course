# Local profile (default): SQLite + local Whisper + Ollama.
MEETINGS_RUNTIME=local
MEETINGS_DATA=./data
MEETINGS_MODEL=qwen3:8b

# Vercel profile. Turso and Blob values are injected by Vercel integrations.
# MEETINGS_RUNTIME=vercel
# TURSO_DATABASE_URL=libsql://...
# TURSO_AUTH_TOKEN=...
# BLOB_READ_WRITE_TOKEN=...
# MEETINGS_TRANSCRIPTION_MODEL=assemblyai/best
# MEETINGS_ANALYSIS_MODEL=openai/gpt-5-mini
