# Copy to .env, edit locally, then run: set -a; source .env; set +a
# Do not send keys in chat or include .env in an archive.
MODEL_API_KEY=
# Provider URL including /v1 if required by provider documentation.
API_BASE_URL=https://api.openai.com/v1
# responses for OpenAI Responses; chat_completions for compatible providers.
API_STYLE=responses
# json_schema if supported; json_object or prompt otherwise.
JSON_MODE=json_schema
WORKER_MODEL=gpt-4.1-mini-2025-04-14
JUDGE_MODEL=gpt-4.1-2025-04-14
CLIENT_MODEL=gpt-4.1-mini-2025-04-14
PORT=8765
